# Copy to .env.local. Only NEXT_PUBLIC_* variables reach the browser, and they
# are inlined at build time: changing one requires restarting `pnpm dev` or
# rebuilding.

# Base URL of internal-platform-api, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where the basemap lives: colombia.pmtiles and fonts/ (Centrale Sans glyphs).
# In development the files sit in public/mapas (outside git); in production the
# edge Caddy serves the same path. See docs/mapa-comercial.md.
NEXT_PUBLIC_MAP_ASSETS_URL=/mapas

# WhatsApp link of the support line, shown at the foot of the public PQRSF form.
# Without it the form links to a placeholder number.
NEXT_PUBLIC_PQRSF_SUPPORT_WHATSAPP_URL=https://wa.me/570000000000
